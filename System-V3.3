-- ==========================================================
--  HELPERS
-- ==========================================================
local function normalizar(nome)
    nome = nome:lower()
    nome = nome:gsub("%s*%b()", "")
    nome = nome:gsub("%s+", " ")
    nome = nome:gsub("^%s+", ""):gsub("%s+$", "")
    return nome
end

local function isGun(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local nome = normalizar(tool.Name)
    for _, g in ipairs(GUNS_LISTA) do
        local ng = normalizar(g)
        if nome == ng or nome:find(ng, 1, true) then return true end
    end
    if nome:find("gun")
       and not nome:find("knife")
       and not nome:find("blade")
       and not nome:find("scythe")
       and not nome:find("axe") then
        return true
    end
    return false
end

local function estaComGun(character)
    local tool = character:FindFirstChildOfClass("Tool")
    return tool and isGun(tool)
end

