--// .Zoewar MM2 Script (UI Cápsula com Fundo Transparente, Tecla 'E', PC/Mobile)
--// Sistema: Sound Gun (do Painel Scripts MM2) — Funciona em MM2 e MMV
--// ON = Verde ✅ | OFF = Vermelho ❌

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer

local enabled = false
local gunConnections = {}
local actionSound = nil
local gunCharConnection = nil

local SOUND_ID = "rbxassetid://6968135315"
local TARGET_TOOL_NAME = "Gun"
local COOLDOWN_DURATION = 2

--// ==========================================================
--// SISTEMA SOUND GUN (do Painel Scripts MM2)
--// ==========================================================
local function setupGunSystem(character)
	if not enabled then return end
	local humanoid = character:WaitForChild("Humanoid", 10)
	local animator = humanoid and humanoid:WaitForChild("Animator", 10)
	local lastUnequippedTime = 0

	if animator then
		local c1 = animator.AnimationPlayed:Connect(function(track)
			local tool = character:FindFirstChildOfClass("Tool")
			local isHoldingGun = tool and tool.Name == TARGET_TOOL_NAME
			local timeSinceUnequip = os.clock() - lastUnequippedTime
			if (isHoldingGun or timeSinceUnequip <= COOLDOWN_DURATION)
			   and track.Priority == Enum.AnimationPriority.Action then
				track:Stop()
			end
		end)
		table.insert(gunConnections, c1)
	end

	local c2 = character.ChildAdded:Connect(function(c)
		if c:IsA("Tool") and c.Name == TARGET_TOOL_NAME and actionSound then
			actionSound:Play()
		end
	end)

	local c3 = character.ChildRemoved:Connect(function(c)
		if c:IsA("Tool") and c.Name == TARGET_TOOL_NAME and actionSound then
			actionSound:Play()
			lastUnequippedTime = os.clock()
		end
	end)

	table.insert(gunConnections, c2)
	table.insert(gunConnections, c3)
end

--// ==========================================================
--// GUI (Cápsula — PC e Mobile)
--// ==========================================================
local gui = Instance.new("ScreenGui")
gui.Parent = game.CoreGui
gui.Name = "zoewar"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false

local main = Instance.new("Frame")
main.Parent = gui
main.Size = UDim2.new(0, 135, 0, 32)
main.Position = UDim2.new(0.5, -67, 0.75, 0)
main.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
main.BackgroundTransparency = 0.5
main.BorderSizePixel = 0

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = main

local title = Instance.new("TextLabel")
title.Parent = main
title.BackgroundTransparency = 1
title.Size = UDim2.new(0.55, 0, 1, 0)
title.Position = UDim2.new(0, 10, 0, 0)
title.Font = Enum.Font.GothamBold
title.Text = ".zoewar"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextScaled = true
title.TextXAlignment = Enum.TextXAlignment.Left

local toggle = Instance.new("TextButton")
toggle.Parent = main
toggle.Size = UDim2.new(0, 42, 0, 22)
toggle.Position = UDim2.new(1, -50, 0.5, -11)
toggle.Font = Enum.Font.GothamBold
toggle.TextScaled = true
toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
toggle.BorderSizePixel = 0

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(1, 0)
toggleCorner.Parent = toggle

--// ==========================================================
--// ATUALIZAR VISUAL DO BOTÃO
--// ==========================================================
local function updateUI()
	if enabled then
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(0, 255, 0)   -- ✅ VERDE quando ON
	else
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(255, 0, 0)   -- ❌ VERMELHO quando OFF
	end
end

--// ==========================================================
--// ATIVAR / DESATIVAR
--// ==========================================================
local function activateSystem()
	actionSound = Instance.new("Sound", SoundService)
	actionSound.Name = "ZoewarEquipSound"
	actionSound.SoundId = SOUND_ID
	actionSound.Volume = 1

	if player.Character then
		setupGunSystem(player.Character)
	end

	gunCharConnection = player.CharacterAdded:Connect(function(char)
		if enabled then setupGunSystem(char) end
	end)
end

local function deactivateSystem()
	if gunCharConnection then
		gunCharConnection:Disconnect()
		gunCharConnection = nil
	end

	for _, c in ipairs(gunConnections) do
		c:Disconnect()
	end
	table.clear(gunConnections)

	if actionSound then
		actionSound:Destroy()
		actionSound = nil
	end
end

local function toggleState()
	enabled = not enabled
	updateUI()

	if enabled then
		activateSystem()
	else
		deactivateSystem()
	end
end

--// Setup inicial (caso personagem já exista)
if player.Character and enabled then
	setupGunSystem(player.Character)
end

-- Ação do botão ON/OFF (PC/Mobile)
toggle.Activated:Connect(function()
	toggleState()
end)

-- Atalho com a tecla "E" (ignora se estiver digitando no chat)
UIS.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
		toggleState()
	end
end)

updateUI()

--// ==========================================================
--// SISTEMA DE ARRASTAR (PC + MOBILE)
--// ==========================================================
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
	local delta = input.Position - dragStart
	main.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

main.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)
