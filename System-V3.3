--// .Zoewar MM2 Script (Completo: Sistema Avançado + GUI Cápsula + Tecla E + Notificação)

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local enabled = false
local SOUND_ID = "rbxassetid://6968135315" -- Som clássico de equipar arma

local actionSound = nil
local gunConnections = {}
local gunCharConnection = nil
local lastUnequippedTime = 0
local COOLDOWN_DURATION = 2

--// ==================== DETECÇÃO AVANÇADA DE ARMAS ====================
local function isGun(tool)
	if not tool or not tool:IsA("Tool") then
		return false
	end

	local name = tool.Name:lower()

	-- Bloqueio Dex's Scope
	if name:find("dex", 1, true) then
		return false
	end

	-- Bloqueio de facas (genérico)
	local banWords = {
		"knife", "blade", "dagger", "sword", "katana", "machete", "scythe",
		"axe", "hatchet", "cleaver", "shank", "shiv", "claw", "fang",
		"seer", "shard", "slasher", "saw", "tides", "heat", "eternal",
		"nightblade", "spider", "chill", "peppermint", "cookieblade",
		"heartblade", "eggblade", "bioblade", "deathshard", "boneblade",
		"winters", "icewing", "logchopper", "batwing", "hallowscythe",
		"celestial", "traveler's axe", "vampire's axe"
	}

	for _, word in ipairs(banWords) do
		if name:find(word, 1, true) then
			return false
		end
	end

	-- Tem que ter Handle
	local handle = tool:FindFirstChild("Handle")
	if not handle or not handle:IsA("BasePart") then
		return false
	end

	-- ===== ARMAS ESPECÍFICAS =====
	local gunWords = {
		"gun",
		"sheriff",
		"icepiercer",
		"harvester",
		"red luger",
		"gingerscope",
		"raygun",
		"snowcannon",
		"blizzard",
		"luger",
		"elderwood",
		"vampire",
		"revolver",
		"pistol",
		"blaster",
		"laser",
		"scope",
		"cannon",
		"beam",
		"shot"
	}

	for _, word in ipairs(gunWords) do
		if name:find(word, 1, true) then
			return true
		end
	end

	-- Fallback estrutural (para qualquer item com aparência de gun/revolver)
	local score = 0

	for _, child in ipairs(tool:GetDescendants()) do
		local cname = child.Name:lower()

		if cname:find("muzzle") or cname:find("barrel") or cname:find("fire") or cname:find("shoot") then
			score += 5
		end
		if cname:find("ammo") or cname:find("clip") or cname:find("mag") or cname:find("damage") or cname:find("firerate") then
			score += 4
		end
		if child:IsA("Sound") then
			local sid = tostring(child.SoundId):lower()
			if sid:find("gun") or sid:find("shoot") or sid:find("fire") or sid:find("pistol") or sid:find("rifle") or sid:find("laser") then
				score += 5
			end
		end
		if child:IsA("Attachment") and (cname:find("muzzle") or cname:find("fire") or cname:find("barrel")) then
			score += 5
		end
	end

	return score >= 5
end

