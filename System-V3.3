-- ==========================================
-- DETECÇÃO
-- ==========================================
local function normalizarNome(nome)
    nome = nome:lower()
    nome = nome:gsub("%s*%b()", "")
    nome = nome:gsub("%s+", " ")
    nome = nome:gsub("^%s+", ""):gsub("%s+$", "")
    return nome
end

local function isGun(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local nome = normalizarNome(tool.Name)

    for _, gun in ipairs(GUNS_LISTA) do
        local g = normalizarNome(gun)
        if nome == g or nome:find(g, 1, true) then
            return true
        end
    end

    if nome:find("gun") and not nome:find("knife") and not nome:find("blade")
        and not nome:find("scythe") and not nome:find("axe") then
        return true
    end

    return false
end

local function estaComGun(character)
    local tool = character:FindFirstChildOfClass("Tool")
    return tool and isGun(tool)
end

-- ==========================================
-- BLOQUEIO DE ANIMAÇÃO (por nome + prioridade alta)
-- ==========================================
local animacoesPermitidas = {}
local fimJanelaSnapshot = 0
local snapshotConcluido = true

local ANIMACOES_RELOAD = {
    "reload", "recarreg", "rechamber", "chamber", "bolt", "cock",
    "magazine", "mag", "load", "unload"
}

local ANIMACOES_PERMITIR = {
    "idle", "walk", "run", "jump", "fall", "climb", "swim",
    "sit", "pose", "death", "die", "hold", "equip", "unequip",
    "tool", "ready", "aim", "aiming", "scope", "ginger"
}

local function ehActionAlta(p)
    return p == Enum.AnimationPriority.Action
        or p == Enum.AnimationPriority.Action2
        or p == Enum.AnimationPriority.Action3
        or p == Enum.AnimationPriority.Action4
end

local function deveBloquear(track)
    local nome = ""
    pcall(function()
        if track.Animation then
            nome = track.Animation.Name:lower()
        end
    end)

    if nome ~= "" then
        for _, p in ipairs(ANIMACOES_PERMITIR) do
            if nome:find(p) then return false end
        end
        for _, p in ipairs(ANIMACOES_RELOAD) do
            if nome:find(p) then return true end
        end
    end

    if ehActionAlta(track.Priority) then
        local id = nil
        pcall(function()
            if track.Animation then id = track.Animation.AnimationId end
        end)
        if id and animacoesPermitidas[id] then
            return false
        end
        return true
    end

    return false
end

-- ==========================================
-- SOM CLÁSSICO
-- ==========================================
local SOUND_ID = "rbxassetid://282906960"
local actionSound = nil

-- ==========================================
-- MOTOR6D (anti-recuo reforçado)
-- ==========================================
local conexaoMotor = nil
local offsetsOriginais = {}

local function capturarOffsets(character)
    for _, nome in ipairs({"Right Shoulder", "Left Shoulder"}) do
        local ombro = character:FindFirstChild(nome)
        if not ombro and character:FindFirstChild("Torso") then
            ombro = character.Torso:FindFirstChild(nome)
        end
        if ombro and ombro:IsA("Motor6D") then
            offsetsOriginais[nome] = ombro.C0
        end
    end
end

local function resetarMotores(character)
    for _, nome in ipairs({"Right Shoulder", "Left Shoulder"}) do
        local ombro = character:FindFirstChild(nome)
        if not ombro and character:FindFirstChild("Torso") then
            ombro = character.Torso:FindFirstChild(nome)
        end
        if ombro and offsetsOriginais[nome] then
            ombro.C0 = offsetsOriginais[nome]
        end
    end
end

-- ==========================================
-- SISTEMA PRINCIPAL
-- ==========================================
local soundGunAtivado = false
local gunConnections = {}
local gunCharConnection = nil

local function iniciarSnapshot()
    table.clear(animacoesPermitidas)
    snapshotConcluido = false
    fimJanelaSnapshot = os.clock() + 0.4
end

local function setupGunSystem(character)
    if not soundGunAtivado then return end

    local humanoid = character:WaitForChild("Humanoid", 10)
    local animator = humanoid and humanoid:WaitForChild("Animator", 10)

    task.wait(0.5)
    capturarOffsets(character)

    if conexaoMotor then conexaoMotor:Disconnect() end
    conexaoMotor = RunService.RenderStepped:Connect(function()
        if not soundGunAtivado then return end
        if not estaComGun(character) then return end
        resetarMotores(character)
    end)

    if animator then
        local c1 = animator.AnimationPlayed:Connect(function(track)
            if not estaComGun(character) then return end

            if not snapshotConcluido then
                if os.clock() <= fimJanelaSnapshot then
                    local id = nil
                    pcall(function()
                        if track.Animation then id = track.Animation.AnimationId end
                    end)
                    if id then animacoesPermitidas[id] = true end
                    return
                end
                snapshotConcluido = true
            end

            if deveBloquear(track) then
                pcall(function() track:Stop(0) end)
                pcall(function() track:AdjustSpeed(0) end)
                pcall(function() track:AdjustWeight(0, 0) end)
                pcall(function() track.TimePosition = 0 end)

                task.spawn(function()
                    for _ = 1, 20 do
                        if not track.Parent then break end
                        pcall(function() track:Stop(0) end)
                        pcall(function() track:AdjustWeight(0, 0) end)
                        RunService.RenderStepped:Wait()
                    end
                end)
            end
        end)
        table.insert(gunConnections, c1)
    end

    local c2 = character.ChildAdded:Connect(function(c)
        if c:IsA("Tool") and isGun(c) then
            iniciarSnapshot()
            if actionSound then actionSound:Play() end
        end
    end)

    local c3 = character.ChildRemoved:Connect(function(c)
        if c:IsA("Tool") and isGun(c) then
            table.clear(animacoesPermitidas)
            snapshotConcluido = true
            if actionSound then actionSound:Play() end
        end
    end)

    table.insert(gunConnections, c2)
    table.insert(gunConnections, c3)
end

-- ==========================================
-- BACKPACK (corrige bug da tecla 1)
-- ==========================================
local function setupBackpack()
    local backpack = player:WaitForChild("Backpack", 10)
    if not backpack then return end

    local b1 = backpack.ChildRemoved:Connect(function(c)
        if c:IsA("Tool") and isGun(c) then
            iniciarSnapshot()
            if actionSound then actionSound:Play() end
        end
    end)

    local b2 = backpack.ChildAdded:Connect(function(c)
        if c:IsA("Tool") and isGun(c) then
            table.clear(animacoesPermitidas)
            snapshotConcluido = true
            if actionSound then actionSound:Play() end
        end
    end)

    table.insert(gunConnections, b1)
    table.insert(gunConnections, b2)
end

-- ==========================================
-- UI + TOGGLE
-- ==========================================
local enabled = false

local function updateUI()
    if enabled then
        toggle.Text = "ON"
        toggle.BackgroundColor3 = Color3.fromRGB(0,255,0)
    else
        toggle.Text = "OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(255,0,0)
    end
end

local function toggleSoundGun()
    enabled = not enabled
    soundGunAtivado = enabled

    if soundGunAtivado then
        actionSound = Instance.new("Sound", SoundService)
        actionSound.SoundId = SOUND_ID
        actionSound.Volume = 1

        if player.Character then setupGunSystem(player.Character) end
        gunCharConnection = player.CharacterAdded:Connect(function(char)
            setupGunSystem(char)
            task.wait(1)
            if soundGunAtivado then setupBackpack() end
        end)

        setupBackpack()
    else
        if gunCharConnection then gunCharConnection:Disconnect() gunCharConnection = nil end
        if conexaoMotor then conexaoMotor:Disconnect() conexaoMotor = nil end
        for _, c in ipairs(gunConnections) do c:Disconnect() end
        table.clear(gunConnections)
        if actionSound then actionSound:Destroy() actionSound = nil end
    end

    updateUI()
end

toggle.MouseButton1Click:Connect(toggleSoundGun)

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.E then
        toggleSoundGun()
    end
end)

updateUI()

-- ==========================================
-- DRAG
-- ==========================================
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
    local delta = input.Position - dragStart
    main.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end

main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

main.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)
