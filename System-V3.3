-- ON/OFF
local toggle = Instance.new("TextButton")
toggle.Parent = main
toggle.Size = UDim2.new(0, 42, 0, 22)
toggle.Position = UDim2.new(1, -50, 0.5, -11)
toggle.Font = Enum.Font.GothamBold
toggle.TextScaled = true
toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
toggle.BorderSizePixel = 0

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(1, 0)
toggleCorner.Parent = toggle

-- Estado visual
local enabled = false

local function updateUI()
	if enabled then
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
	else
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	end
end

local function toggleState()
	enabled = not enabled
	updateUI()
end

toggle.MouseButton1Click:Connect(toggleState)

-- Atalho no teclado: Tecla 'E' ativa/desativa no PC
UIS.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
		toggleState()
	end
end)

updateUI()

-- DRAG MOBILE/PC
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
	local delta = input.Position - dragStart

	main.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

main.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)

-- ABORDAGEM DE EXCLUSÃO RADICAL DE ANIMATORS (MM2 / RAGDOLL ENGINE / ETC)
-- O MM2 cria clones de animators e injeta animações por scripts locais ocultos nas ferramentas.
-- Aqui nós destruímos o motor de animação da ferramenta e interceptamos a criação de instâncias de Animation.

local function scrubTool(tool)
	if not tool:IsA("Tool") then return end
	
	-- Mata absolutamente qualquer script local, módulo ou motor de animação dentro da arma
	for _, desc in ipairs(tool:GetDescendants()) do
		if desc:IsA("LocalScript") or desc:IsA("ModuleScript") then
			desc.Disabled = true
			desc:Destroy()
		elseif desc:IsA("Animation") then
			desc.AnimationId = ""
		end
	end
	
	tool.ChildAdded:Connect(function(desc)
		if enabled then
			if desc:IsA("LocalScript") or desc:IsA("ModuleScript") then
				desc.Disabled = true
				desc:Destroy()
			elseif desc:IsA("Animation") then
				desc.AnimationId = ""
			end
		end
	end)
end

-- Limpa ferramentas já existentes na mochila e no personagem
if LocalPlayer.Backpack then
	for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
		scrubTool(item)
	end
	LocalPlayer.Backpack.ChildAdded:Connect(scrubTool)
end

if LocalPlayer.Character then
	for _, item in ipairs(LocalPlayer.Character:GetChildren()) do
		scrubTool(item)
	end
	LocalPlayer.Character.ChildAdded:Connect(scrubTool)
end

LocalPlayer.CharacterAdded:Connect(function(char)
	char.ChildAdded:Connect(scrubTool)
	LocalPlayer.Backpack.ChildAdded:Connect(scrubTool)
end)

-- Metatable Hooking agressivo: Bloqueia a função LoadAnimation do Animator nativamente via código do cliente
pcall(function()
	local mt = getrawmetatable(game)
	setreadonly(mt, false)
	local oldIndex = mt.__index
	
	-- Intercepta qualquer chamada de reprodução de animação a nível de motor de jogo
	local gch = game.CoreGui
	
	local function clearTracks()
		if enabled and LocalPlayer.Character then
			local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				local animator = humanoid:FindFirstChildOfClass("Animator")
				if animator then
					for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
						track:Stop()
						track:AdjustSpeed(0)
					end
				end
			end
		end
	end
	
	game:GetService("RunService").Stepped:Connect(clearTracks)
end)
