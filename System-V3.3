-- ==========================================================
--  DETECÇÃO DE GUN (baseada na lista oficial)
-- ==========================================================
local function normalizarNome(nome)
	nome = nome:lower()
	nome = nome:gsub("%s*%b()", "")   -- remove "(Gun)", "(2019)" etc.
	nome = nome:gsub("%s+", " ")
	nome = nome:gsub("^%s+", ""):gsub("%s+$", "")
	return nome
end

local function isGun(tool)
	if not tool or not tool:IsA("Tool") then return false end

	local nome = normalizarNome(tool.Name)

	-- Bloqueio Dex's Scope
	if nome:find("dex", 1, true) then
		return false
	end

	-- Bloqueio forte de facas
	local banWords = {
		"knife", "blade", "dagger", "sword", "katana", "machete", "scythe",
		"axe", "hatchet", "cleaver", "shank", "shiv", "claw", "fang",
		"seer", "shard", "slasher", "saw", "tides", "heat", "eternal",
		"nightblade", "spider", "chill", "peppermint", "cookieblade",
		"heartblade", "eggblade", "bioblade", "deathshard", "boneblade",
		"winters", "icewing", "logchopper", "batwing", "hallowscythe",
		"celestial", "traveler's axe", "vampire's axe", "icebreaker"
	}
	for _, word in ipairs(banWords) do
		if nome:find(word, 1, true) then
			return false
		end
	end

	-- Verifica contra a lista oficial
	for _, gun in ipairs(GUNS_LISTA) do
		local g = normalizarNome(gun)
		if nome == g or nome:find(g, 1, true) then
			return true
		end
	end

	-- Fallback: se tiver "gun" no nome e não for faca
	if nome:find("gun")
		and not nome:find("knife")
		and not nome:find("blade")
		and not nome:find("scythe")
		and not nome:find("axe") then
		return true
	end

	return false
end

local function estaComGun(character)
	local tool = character:FindFirstChildOfClass("Tool")
	return tool and isGun(tool)
end

-- ==========================================================
--  MOTOR DE ANTI-RECOIL (Motor6D Torso + Camera + Velocidade)
-- ==========================================================
local function capturarBaseline(character)
	baselineMotors = {}
	for _, obj in ipairs(character:GetDescendants()) do
		if obj:IsA("Motor6D") then
			local n = obj.Name:lower() -- Convertido para minúsculo para facilitar a busca
			-- INCLUÍDO "waist", "root", "torso", "neck" para travar o quadril e o torso
			if n:find("shoulder") or n:find("elbow")
			   or n:find("wrist") or n:find("arm")
			   or n:find("waist") or n:find("root")
			   or n:find("neck") or n:find("torso") then
				baselineMotors[obj] = { C0 = obj.C0, C1 = obj.C1 }
			end
		end
	end
end

local function detectarRecoil()
	for motor, base in pairs(baselineMotors) do
		if motor.Parent then
			if motor.C0 ~= base.C0 or motor.C1 ~= base.C1 then
				return true
			end
		end
	end
	return false
end

local function restaurarMotors()
	for motor, base in pairs(baselineMotors) do
		if motor.Parent then
			if motor.C0 ~= base.C0 then motor.C0 = base.C0 end
			if motor.C1 ~= base.C1 then motor.C1 = base.C1 end
		end
	end
end

--// Atualizar o visual do botão ON/OFF
local function updateUI()
	if enabled then
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- Verde
	else
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Vermelho
	end
end

--// Alternar Estado
local function toggleState()
	enabled = not enabled
	updateUI()
	
	if not enabled then
		baselineMotors = {}
		ultimoTiro = 0
	elseif player.Character then
		task.delay(0.1, function()
			if player.Character and player.Character.Parent then
				capturarBaseline(player.Character)
			end
		end)
	end
end

--// Bloqueio de animações indesejadas (Recarga e Anti-Recuo)
local function setup(character)
	-- Limpa conexões antigas para evitar lag e vazamentos
	for _, c in ipairs(gunConnections) do c:Disconnect() end
	table.clear(gunConnections)

	local humanoid = character:WaitForChild("Humanoid")
	local animator = humanoid:WaitForChild("Animator")

	-- Captura a posição base dos braços e torso para o Anti-Recuo
	capturarBaseline(character)
	ultimaVelocidade = Vector3.new(0, 0, 0)

	if connection then
		connection:Disconnect()
	end

	connection = animator.AnimationPlayed:Connect(function(track)
		if enabled then
			local animId = track.Animation and track.Animation.AnimationId or ""
			local nameLower = track.Name:lower()
			
			-- Bloqueia APENAS recarga e ID específico. 
			-- Não bloqueia "shoot/fire/recoil" para não quebrar a pose de duas mãos.
			if animId:find("558601175") or nameLower:find("reload") then
				track:Stop()
			end
		end
	end)

	-- Anti-Recuo Motor6D e Câmera (RenderStepped)
	local conn1 = RunService.RenderStepped:Connect(function()
		if not enabled or not character.Parent then return end
		if not estaComGun(character) then return end

		if detectarRecoil() then
			ultimoTiro = os.clock()
		end

		if (os.clock() - ultimoTiro) <= JANELA_RECOIL then
			restaurarMotors()
			if humanoid then
				humanoid.CameraOffset = CAMERA_BASE
			end
		end
	end)
	table.insert(gunConnections, conn1)

	-- Anti-Recuo de Velocidade (Heartbeat) - Impede o empurrão físico
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if root then
		local conn2 = RunService.Heartbeat:Connect(function()
			if not enabled or not character.Parent then return end
			if not estaComGun(character) then return end
			if not root.Parent then return end

			local vel = root.AssemblyLinearVelocity
			local deltaVel = vel - ultimaVelocidade

			if deltaVel.Magnitude > LIMITE_VEL then
				root.AssemblyLinearVelocity = Vector3.new(
					ultimaVelocidade.X,
					vel.Y,
					ultimaVelocidade.Z
				)
			else
				ultimaVelocidade = vel
			end
		end)
		table.insert(gunConnections, conn2)
	end

	-- Som e Atualização de Baseline ao equipar
	local conn3 = character.ChildAdded:Connect(function(child)
		if enabled and isGun(child) then
			equipSound:Play()
			task.delay(0.35, function()
				if character.Parent and estaComGun(character) then
					capturarBaseline(character) -- Recaptura a posição correta quando a arma é equipada
				end
			end)
		end
	end)
	table.insert(gunConnections, conn3)

	local conn4 = character.ChildRemoved:Connect(function(child)
		if enabled and isGun(child) then
			equipSound:Play()
		end
	end)
	table.insert(gunConnections, conn4)
end

if player.Character then
	setup(player.Character)
end

player.CharacterAdded:Connect(setup)

-- Ação ao clicar no botão ON/OFF (Compatível PC/Mobile)
toggle.Activated:Connect(function()
	toggleState()
end)

--// Atalho com a Tecla "E" (Apenas PC, ignorando se estiver digitando no chat)
UIS.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
		toggleState()
	end
end)

updateUI()

--// SISTEMA DE ARRASTAR COMPATÍVEL COM PC E MOBILE
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
	local delta = input.Position - dragStart

	main.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

main.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)
