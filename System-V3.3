local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- GUI
local gui = Instance.new("ScreenGui")
gui.Parent = game.CoreGui
gui.Name = "zoewar"
gui.ResetOnSpawn = false

-- Fundo estilo cápsula com transparência fosca (Glassmorphism / Translucido)
local main = Instance.new("Frame")
main.Parent = gui
main.Size = UDim2.new(0, 135, 0, 32)
main.Position = UDim2.new(0.5, -67, 0.75, 0)
main.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
main.BackgroundTransparency = 0.4 -- Efeito meio fosco/transparente para ver o fundo
main.BorderSizePixel = 0

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = main

-- Borda sutil para dar acabamento fosco
local stroke = Instance.new("UIStroke")
stroke.Parent = main
stroke.Color = Color3.fromRGB(255, 255, 255)
stroke.Transparency = 0.7
stroke.Thickness = 1

-- Texto
local title = Instance.new("TextLabel")
title.Parent = main
title.BackgroundTransparency = 1
title.Size = UDim2.new(0.55, 0, 1, 0)
title.Position = UDim2.new(0, 10, 0, 0)
title.Font = Enum.Font.GothamBold
title.Text = ".zoewar"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextScaled = true
title.TextXAlignment = Enum.TextXAlignment.Left

-- ON/OFF
local toggle = Instance.new("TextButton")
toggle.Parent = main
toggle.Size = UDim2.new(0, 42, 0, 22)
toggle.Position = UDim2.new(1, -50, 0.5, -11)
toggle.Font = Enum.Font.GothamBold
toggle.TextScaled = true
toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
toggle.BorderSizePixel = 0

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(1, 0)
toggleCorner.Parent = toggle

-- Estado visual
local enabled = false

local function updateUI()
	if enabled then
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
	else
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	end
end

local function toggleState()
	enabled = not enabled
	updateUI()
	
	-- Aqui você pode colocar a lógica extra que ativa/desativa quando o script estiver ON
end

toggle.MouseButton1Click:Connect(toggleState)

-- Atalho no teclado: Tecla 'E' ativa/desativa no PC
UIS.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
		toggleState()
	end
end)

updateUI()

-- DRAG MOBILE/PC
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
	local delta = input.Position - dragStart

	main.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

main.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)

-- MODIFICAÇÕES DE ANIMAÇÕES DO MM2 (Gingerscope / Armas / Recuo)
task.spawn(function()
	pcall(function()
		LocalPlayer.CharacterAdded:Connect(function(char)
			local humanoid = char:WaitForChild("Humanoid")
			
			humanoid.AnimationPlayed:Connect(function(animTrack)
				local animId = tostring(animTrack.Animation.AnimationId)
				
				-- Bloqueia animações de tiro, recuo para trás e de uma mão da Gingerscope/Armas do MM2
				if enabled then
					if string.find(animId, "10714353347") or string.find(animId, "Gun") or string.find(animId, "Shoot") or string.find(animId, "Recoil") then
						animTrack:Stop()
					end
				end
			end)
		end)
		
		if LocalPlayer.Character then
			local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.AnimationPlayed:Connect(function(animTrack)
					local animId = tostring(animTrack.Animation.AnimationId)
					if enabled then
						if string.find(animId, "10714353347") or string.find(animId, "Gun") or string.find(animId, "Shoot") or string.find(animId, "Recoil") then
							animTrack:Stop()
						end
					end
				end)
			end
		end
	end)
end)
