--// Atualizar o visual do botão ON/OFF
local function updateUI()
	if enabled then
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- Verde
	else
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Vermelho
	end
end

--// ==================== SISTEMA DE ANIMAÇÃO E EVENTOS ====================
local function setupGunSystem(character)
	if not enabled then return end

	local humanoid = character:WaitForChild("Humanoid", 10)
	local animator = humanoid and humanoid:WaitForChild("Animator", 10)
	lastUnequippedTime = 0

	if animator then
		local c1 = animator.AnimationPlayed:Connect(function(track)
			local tool = character:FindFirstChildOfClass("Tool")
			local isHoldingGun = tool and isGun(tool)
			local timeSinceUnequip = os.clock() - lastUnequippedTime
			local withinCooldown = timeSinceUnequip <= COOLDOWN_DURATION

			if isHoldingGun or withinCooldown then
				local animId = track.Animation and track.Animation.AnimationId or ""
				local nameLower = track.Name:lower()

				if animId:find("558601175") or nameLower:find("reload") or nameLower:find("shoot") or nameLower:find("fire") or nameLower:find("recoil") or nameLower:find("kick")
					or track.Priority == Enum.AnimationPriority.Action
					or track.Priority == Enum.AnimationPriority.Action2
					or track.Priority == Enum.AnimationPriority.Action3
					or track.Priority == Enum.AnimationPriority.Action4 then
					track:Stop(0)
				end
			end
		end)
		table.insert(gunConnections, c1)
	end

	local c2 = character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and isGun(child) then
			if actionSound then
				actionSound:Stop()
				actionSound.TimePosition = 0
				actionSound:Play()
			end
		end
	end)

	local c3 = character.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") and isGun(child) then
			if actionSound then
				actionSound:Stop()
				actionSound.TimePosition = 0
				actionSound:Play()
			end
			lastUnequippedTime = os.clock()
		end
	end)

	table.insert(gunConnections, c2)
	table.insert(gunConnections, c3)
end

--// Alternar Estado do Script
local function toggleState()
	enabled = not enabled
	updateUI()

	if enabled then
		if not actionSound then
			actionSound = Instance.new("Sound")
			actionSound.Name = "ZoewarEquipSound"
			actionSound.SoundId = SOUND_ID
			actionSound.Volume = 1
			actionSound.Parent = SoundService
		end

		if player.Character then
			setupGunSystem(player.Character)
		end
		gunCharConnection = player.CharacterAdded:Connect(setupGunSystem)
	else
		if gunCharConnection then
			gunCharConnection:Disconnect()
			gunCharConnection = nil
		end

		for _, conn in ipairs(gunConnections) do
			conn:Disconnect()
		end
		table.clear(gunConnections)

		if actionSound then
			actionSound:Destroy()
			actionSound = nil
		end
	end
end

-- Ação ao clicar no botão ON/OFF
toggle.Activated:Connect(function()
	toggleState()
end)

-- Atalho com a Tecla "E"
UIS.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
		toggleState()
	end
end)

updateUI()

--// ==================== SISTEMA DE ARRASTAR (PC e Mobile) ====================
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
	local delta = input.Position - dragStart
	main.Position = UDim2.new(
		startPos.X.Scale, startPos.X.Offset + delta.X,
		startPos.Y.Scale, startPos.Y.Offset + delta.Y
	)
end

main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

main.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)

