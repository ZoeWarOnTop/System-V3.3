--// .Zoewar MM2 Script (Removed Reload Animation for ALL Guns + Classic Sound + UI + Key E)

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local enabled = false
local connection

local OLD_SOUND_ID = "rbxassetid://6968135315" -- Som clássico de equipar arma (2023-2024)

--// GUI Principal (Compatível PC e Mobile)
local gui = Instance.new("ScreenGui")
gui.Parent = game.CoreGui
gui.Name = "zoewar"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false

-- Fundo estilo cápsula com fundo transparente
local main = Instance.new("Frame")
main.Parent = gui
main.Size = UDim2.new(0, 160, 0, 32)
main.Position = UDim2.new(0.5, -80, 0.75, 0)
main.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
main.BackgroundTransparency = 0.5 
main.BorderSizePixel = 0

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = main

-- Texto (".Zoewar ON / OFF") à esquerda (tamanho ajustado para caber o texto completo)
local title = Instance.new("TextLabel")
title.Parent = main
title.BackgroundTransparency = 1
title.Size = UDim2.new(0.65, 0, 1, 0)
title.Position = UDim2.new(0, 10, 0, 0)
title.Font = Enum.Font.GothamBold
title.Text = ".Zoewar OFF"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextScaled = true
title.TextXAlignment = Enum.TextXAlignment.Left

-- Botão ON/OFF à direita em formato de pílula
local toggle = Instance.new("TextButton")
toggle.Parent = main
toggle.Size = UDim2.new(0, 48, 0, 22)
toggle.Position = UDim2.new(1, -56, 0.5, -11)
toggle.Font = Enum.Font.GothamBold
toggle.TextScaled = true
toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
toggle.BorderSizePixel = 0

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(1, 0)
toggleCorner.Parent = toggle

-- Configuração do Som de Equipar/Desequipar
local equipSound = Instance.new("Sound")
equipSound.Name = "ZoewarEquipSound"
equipSound.SoundId = OLD_SOUND_ID
equipSound.Volume = 1
equipSound.Parent = SoundService

--// Função ampla para identificar QUALQUER arma do MM2 de forma universal
local function isGun(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local nameLower = tool.Name:lower()
    
    -- Lista abrangente de nomenclaturas de armas e Godlies do MM2
    if nameLower:find("gun") or nameLower:find("sheriff") or nameLower:find("revolver") or nameLower:find("pistol") or 
       nameLower:find("gingerscope") or nameLower:find("blaster") or nameLower:find("luger") or nameLower:find("laser") or 
       nameLower:find("shark") or nameLower:find("sampson") or nameLower:find("tNT") or nameLower:find("cowboy") or 
       nameLower:find("hallow's gun") or nameLower:find("blood") or nameLower:find("peacemaker") or nameLower:find("heat") or 
       nameLower:find("fang") or nameLower:find("db") or nameLower:find("plasmacore") or nameLower:find("elderwood") then
        return true
    end
    
    -- Verificação estrutural por componentes internos comuns em armas do jogo (Handle + Disparo/Munição)
    if tool:FindFirstChild("Handle") and (tool:FindFirstChild("Shoot") or tool:FindFirstChild("ServerSpew") or tool:FindFirstChild("ClientAmmo") or tool:FindFirstChild("Use") or tool:FindFirstChild("GripPos")) then
        return true
    end
    
    return false
end

--// Atualizar o visual do botão e do título ON/OFF
local function updateUI()
	if enabled then
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- Verde
		title.Text = ".Zoewar ON"
	else
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Vermelho
		title.Text = ".Zoewar OFF"
	end
end

--// Alternar Estado
local function toggleState()
	enabled = not enabled
	updateUI()
end

--// Bloqueio universal de animações de recarga para TODAS as armas
local function setup(character)
	local humanoid = character:WaitForChild("Humanoid")
	local animator = humanoid:WaitForChild("Animator")

	if connection then
		connection:Disconnect()
	end

	connection = animator.AnimationPlayed:Connect(function(track)
		if enabled then
			local animId = track.Animation and track.Animation.AnimationId or ""
			local nameLower = track.Name:lower()
			
			-- Intercepta qualquer animação associada a recarga ou recuo de arma em geral (IDs conhecidos e termos textuais)
			if animId:find("558601175") or animId:find("reload") or nameLower:find("reload") or nameLower:find("rechamber") or nameLower:find("cock") then
				track:Stop()
			end
		end
	end)

	character.ChildAdded:Connect(function(child)
		if enabled and isGun(child) then
			equipSound:Play()
		end
	end)

	character.ChildRemoved:Connect(function(child)
		if enabled and isGun(child) then
			equipSound:Play()
		end
	end)
end

if player.Character then
	setup(player.Character)
end

player.CharacterAdded:Connect(setup)

-- Ação ao clicar no botão ON/OFF
toggle.Activated:Connect(function()
	toggleState()
end)

-- Atalho com a Tecla "E"
UIS.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
		toggleState()
	end
end)

updateUI()

--// SISTEMA DE ARRASTAR COMPATÍVEL COM PC E MOBILE
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
	local delta = input.Position - dragStart

	main.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

main.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)

--// NOTIFICAÇÃO DO CANTO INFERIOR DIREITO (Com animação suave)
task.spawn(function()
	local notifFrame = Instance.new("Frame")
	notifFrame.Parent = gui
	notifFrame.Size = UDim2.new(0, 240, 0, 45)
	notifFrame.Position = UDim2.new(1, 250, 1, -65)
	notifFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	notifFrame.BackgroundTransparency = 0.3
	notifFrame.BorderSizePixel = 0

	local notifCorner = Instance.new("UICorner")
	notifCorner.CornerRadius = UDim.new(0, 10)
	notifCorner.Parent = notifFrame

	local notifStroke = Instance.new("UIStroke")
	notifStroke.Color = Color3.fromRGB(0, 255, 128)
	notifStroke.Thickness = 1
	notifStroke.Transparency = 0.5
	notifStroke.Parent = notifFrame

	local notifText = Instance.new("TextLabel")
	notifText.Parent = notifFrame
	notifText.Size = UDim2.new(1, 0, 1, 0)
	notifText.BackgroundTransparency = 1
	notifText.Font = Enum.Font.GothamBold
	notifText.Text = "Obrigado por usar nosso script 🫶"
	notifText.TextColor3 = Color3.fromRGB(255, 255, 255)
	notifText.TextSize = 12
	notifText.TextWrapped = true

	local tweenInfoIn = TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	local tweenInfoOut = TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.In)

	local slideIn = TweenService:Create(notifFrame, tweenInfoIn, {
		Position = UDim2.new(1, -250, 1, -65)
	})
	slideIn:Play()

	task.delay(3.5, function()
		local slideOut = TweenService:Create(notifFrame, tweenInfoOut, {
			Position = UDim2.new(1, 250, 1, -65),
			BackgroundTransparency = 1
		})
		
		local textFade = TweenService:Create(notifText, tweenInfoOut, {
			TextTransparency = 1
		})
		
		local strokeFade = TweenService:Create(notifStroke, tweenInfoOut, {
			Transparency = 1
		})

		slideOut:Play()
		textFade:Play()
		strokeFade:Play()

		slideOut.Completed:Connect(function()
			notifFrame:Destroy()
		end)
	end)
end)
