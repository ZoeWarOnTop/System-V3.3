task.spawn(function()
	local badge = Instance.new("Frame")
	badge.Parent = gui
	badge.Size = UDim2.new(0, 240, 0, 45)
	badge.Position = UDim2.new(1, 250, 1, -60) -- Começa fora da tela (à direita)
	badge.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	badge.BackgroundTransparency = 0.2
	badge.BorderSizePixel = 0

	Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 8)
	
	local bStroke = Instance.new("UIStroke")
	bStroke.Parent = badge
	bStroke.Color = Color3.fromRGB(0, 255, 128)
	bStroke.Transparency = 0.3
	bStroke.Thickness = 1.5

	local bText = Instance.new("TextLabel")
	bText.Parent = badge
	bText.BackgroundTransparency = 1
	bText.Size = UDim2.new(1, -10, 1, 0)
	bText.Position = UDim2.new(0, 5, 0, 0)
	bText.Font = Enum.Font.GothamBold
	bText.Text = "Obrigado(a) por usar nosso script : )"
	bText.TextColor3 = Color3.fromRGB(255, 255, 255)
	bText.TextScaled = true

	-- Animação para entrar na tela (canto inferior direito)
	local tweenIn = TweenService:Create(badge, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(1, -255, 1, -60)
	})
	tweenIn:Play()

	-- Espera 4 segundos e remove suavemente
	task.wait(4)

	local tweenOut = TweenService:Create(badge, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Position = UDim2.new(1, 250, 1, -60)
	})
	tweenOut:Play()
	tweenOut.Completed:Connect(function()
		badge:Destroy()
	end)
end)
