--// Detector de Gun
local function isGun(tool)
    if not tool or not tool:IsA("Tool") then
        return false
    end

    local name = tool.Name:lower()

    if name:find("dex") then
        return false
    end

    local forbidden = {
        "knife", "blade", "dagger", "sword", "scythe",
        "chroma fang", "fang", "claw", "axe"
    }

    for _, word in ipairs(forbidden) do
        if name:find(word) then
            return false
        end
    end

    if not tool:FindFirstChild("Handle") then
        return false
    end

    local gunWords = {
        "gun", "luger", "revolver", "pistol", "blaster",
        "raygun", "laser", "scope", "cannon", "beam",
        "shot", "darkbringer", "lightbringer", "shark",
        "amerilaser", "iceblaster", "hallowgun", "jinglegun",
        "minty", "gingermint", "swirly", "icebeam",
        "plasmabeam", "makeshift", "spectre", "red luger",
        "green luger", "ginger luger", "lugercane", "sugar",
        "rainbow", "ocean", "darkshot", "traveler", "evergun",
        "vampire", "bauble", "constellation", "sunrise",
        "watergun", "snowcannon", "blizzard", "blossom",
        "flora", "flowerwood", "borealis", "xenoshot",
        "pearlshine", "soul", "treat", "matrixscope",
        "bunnyscope", "voidscope", "gingerscope", "redscope",
        "bluescope", "greenscope", "purplescope", "goldscope",
        "icepiercer", "harvester", "chrom", "chroma",
        "sunset", "australis", "sakura", "alienbeam",
        "turkey", "sands", "beachy"
    }

    for _, word in ipairs(gunWords) do
        if name:find(word) then
            return true
        end
    end

    local score = 0

    for _, obj in ipairs(tool:GetDescendants()) do
        local n = obj.Name:lower()

        if n:find("muzzle")
            or n:find("barrel")
            or n:find("fire")
            or n:find("shoot")
            or n:find("recoil") then
            score += 2
        end

        if n:find("ammo")
            or n:find("clip")
            or n:find("mag")
            or n:find("damage")
            or n:find("firerate") then
            score += 1
        end
    end

    return score >= 2
end

local function disconnectAll()
    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(connections)
end

local function setupCharacter(character)
    if not enabled then
        return
    end

    disconnectAll()

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")

    if animator then
        table.insert(connections, animator.AnimationPlayed:Connect(function(track)
            if not enabled then
                return
            end

            local tool = character:FindFirstChildOfClass("Tool")

            if tool and isGun(tool) then
                local animation = track.Animation
                local id = animation and animation.AnimationId or ""
                local animName = animation and animation.Name:lower() or ""

                if id:find("558601175")
                    or animName:find("reload")
                    or animName:find("shoot")
                    or animName:find("fire")
                    or animName:find("recoil")
                    or animName:find("kick") then

                    pcall(function()
                        track:Stop()
                    end)
                end
            end
        end))
    end

    table.insert(connections, character.ChildAdded:Connect(function(child)
        if enabled and child:IsA("Tool") and isGun(child) then
            equipSound:Play()
        end
    end))

    table.insert(connections, character.ChildRemoved:Connect(function(child)
        if enabled and child:IsA("Tool") and isGun(child) then
            equipSound:Play()
        end
    end))
end

local function updateUI()
    if enabled then
        toggle.Text = "ON"
        toggle.BackgroundColor3 = Color3.fromRGB(46, 139, 87)
    else
        toggle.Text = "OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end

local function toggleState()
    enabled = not enabled

    disconnectAll()

    if enabled and player.Character then
        setupCharacter(player.Character)
    end

    updateUI()
end

toggle.Activated:Connect(toggleState)

UIS.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end

    if input.KeyCode == Enum.KeyCode.E then
        toggleState()
    end
end)

characterConnection = player.CharacterAdded:Connect(function(character)
    task.wait(0.5)

    if enabled then
        setupCharacter(character)
    end
end)

--// Arrastar no PC/Mobile
local dragging = false
local dragStart
local startPos

main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if not dragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

updateUI()
