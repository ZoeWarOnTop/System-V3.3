-- ==========================================================
--  DETECÇÃO DE GUN (baseada na lista oficial)
-- ==========================================================
local function normalizarNome(nome)
	nome = nome:lower()
	nome = nome:gsub("%s*%b()", "")
	nome = nome:gsub("%s+", " ")
	nome = nome:gsub("^%s+", ""):gsub("%s+$", "")
	return nome
end

local function isGun(tool)
	if not tool or not tool:IsA("Tool") then return false end

	local nome = normalizarNome(tool.Name)

	if nome:find("dex", 1, true) then return false end

	local banWords = {
		"knife", "blade", "dagger", "sword", "katana", "machete", "scythe",
		"axe", "hatchet", "cleaver", "shank", "shiv", "claw", "fang",
		"seer", "shard", "slasher", "saw", "tides", "heat", "eternal",
		"nightblade", "spider", "chill", "peppermint", "cookieblade",
		"heartblade", "eggblade", "bioblade", "deathshard", "boneblade",
		"winters", "icewing", "logchopper", "batwing", "hallowscythe",
		"celestial", "traveler's axe", "vampire's axe", "icebreaker"
	}
	for _, word in ipairs(banWords) do
		if nome:find(word, 1, true) then return false end
	end

	for _, gun in ipairs(GUNS_LISTA) do
		local g = normalizarNome(gun)
		if nome == g or nome:find(g, 1, true) then return true end
	end

	if nome:find("gun")
		and not nome:find("knife")
		and not nome:find("blade")
		and not nome:find("scythe")
		and not nome:find("axe") then
		return true
	end

	return false
end

--// Atualizar o visual do botão ON/OFF
local function updateUI()
	if enabled then
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
	else
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	end
end

--// Alternar Estado
local function toggleState()
	enabled = not enabled
	updateUI()
end

--// ==========================================================
--// SISTEMA SOUND GUN
--// Cancela animações Action + toca som ao equipar/desequipar
--// ==========================================================
local function setup(character)
	local humanoid = character:WaitForChild("Humanoid")
	local animator = humanoid:WaitForChild("Animator")

	-- Limpa conexões antigas antes de reconectar
	for _, c in ipairs(activeConnections) do
		if c.Connected then c:Disconnect() end
	end
	table.clear(activeConnections)

	-- 1) Cancela QUALQUER animação de prioridade Action
	--    (tiro, recarga, recoil, etc.) enquanto segura a gun
	--    OU durante a janela de cooldown após desequipar.
	local c1 = animator.AnimationPlayed:Connect(function(track)
		if not enabled then return end

		local tool = character:FindFirstChildOfClass("Tool")
		local isHoldingGun = tool and isGun(tool)
		local timeSinceUnequip = os.clock() - lastUnequippedTime

		if (isHoldingGun or timeSinceUnequip <= COOLDOWN_DURATION)
			and track.Priority == Enum.AnimationPriority.Action then
			track:Stop()
		end
	end)
	table.insert(activeConnections, c1)

	-- 2) Toca som ao EQUIPAR (ChildAdded na Character)
	local c2 = character.ChildAdded:Connect(function(child)
		if enabled and isGun(child) then
			equipSound:Play()
		end
	end)
	table.insert(activeConnections, c2)

	-- 3) Toca som ao DESEQUIPAR + marca cooldown (ChildRemoved)
	local c3 = character.ChildRemoved:Connect(function(child)
		if enabled and isGun(child) then
			equipSound:Play()
			lastUnequippedTime = os.clock()
		end
	end)
	table.insert(activeConnections, c3)
end

if player.Character then
	setup(player.Character)
end

player.CharacterAdded:Connect(setup)

-- Ação ao clicar no botão ON/OFF (Compatível PC/Mobile)
toggle.Activated:Connect(function()
	toggleState()
end)

--// Atalho com a Tecla "E" (Apenas PC, ignorando se estiver digitando no chat)
UIS.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
		toggleState()
	end
end)

updateUI()

--// SISTEMA DE ARRASTAR COMPATÍVEL COM PC E MOBILE
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
	local delta = input.Position - dragStart
	main.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

main.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)
