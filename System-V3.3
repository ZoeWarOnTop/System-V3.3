-- ==========================================
-- DETECÇÃO
-- ==========================================
local function normalizarNome(nome)
    nome = nome:lower()
    nome = nome:gsub("%s*%b()", "")
    nome = nome:gsub("%s+", " ")
    nome = nome:gsub("^%s+", ""):gsub("%s+$", "")
    return nome
end

local function isGun(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local nome = normalizarNome(tool.Name)

    for _, gun in ipairs(GUNS_LISTA) do
        local g = normalizarNome(gun)
        if nome == g or nome:find(g, 1, true) then
            return true
        end
    end

    if nome:find("gun") and not nome:find("knife") and not nome:find("blade")
        and not nome:find("scythe") and not nome:find("axe") then
        return true
    end

    return false
end

local function estaComGun(character)
    local tool = character:FindFirstChildOfClass("Tool")
    return tool and isGun(tool)
end

-- ==========================================
-- SOM CLÁSSICO
-- ==========================================
local SOUND_ID = "rbxassetid://282906960"
local actionSound = nil

-- ==========================================
-- 🔥 SNAPSHOT DE ANIMAÇÕES (MÉTODO INFALÍVEL)
-- ==========================================
-- Captura os AnimationIds de TODAS as animações que estiverem rodando
-- no momento que você equipa a gun. Essas são as animações "permitidas"
-- (idle, hold, andar segurando arma).
-- Qualquer animação NOVA que aparecer depois (reload, tiro, recuo) é bloqueada.

local animacoesPermitidas = {}  -- [AnimationId] = true

local function capturarAnimacoesPermitidas(animator)
    table.clear(animacoesPermitidas)
    local ok, tracks = pcall(function()
        return animator:GetPlayingAnimationTracks()
    end)
    if not ok or not tracks then return end

    for _, track in ipairs(tracks) do
        local id = nil
        pcall(function()
            if track.Animation then
                id = track.Animation.AnimationId
            end
        end)
        if id and id ~= "" then
            animacoesPermitidas[id] = true
        end
    end
end

local function animacaoPermitida(track)
    local id = nil
    pcall(function()
        if track.Animation then
            id = track.Animation.AnimationId
        end
    end)
    if not id or id == "" then return false end
    return animacoesPermitidas[id] == true
end

-- ==========================================
-- MOTOR6D (anti-recuo)
-- ==========================================
local conexaoMotor = nil
local offsetsOriginais = {}

local function capturarOffsets(character)
    for _, nome in ipairs({"Right Shoulder", "Left Shoulder"}) do
        local ombro = character:FindFirstChild(nome)
        if not ombro and character:FindFirstChild("Torso") then
            ombro = character.Torso:FindFirstChild(nome)
        end
        if ombro and ombro:IsA("Motor6D") then
            offsetsOriginais[nome] = ombro.C0
        end
    end
end

local function resetarMotores(character)
    for _, nome in ipairs({"Right Shoulder", "Left Shoulder"}) do
        local ombro = character:FindFirstChild(nome)
        if not ombro and character:FindFirstChild("Torso") then
            ombro = character.Torso:FindFirstChild(nome)
        end
        if ombro and offsetsOriginais[nome] then
            ombro.C0 = offsetsOriginais[nome]
        end
    end
end

-- ==========================================
-- SISTEMA PRINCIPAL
-- ==========================================
local soundGunAtivado = false
local gunConnections = {}
local gunCharConnection = nil

local function setupGunSystem(character)
    if not soundGunAtivado then return end

    local humanoid = character:WaitForChild("Humanoid", 10)
    local animator = humanoid and humanoid:WaitForChild("Animator", 10)
    if not animator then return end

    task.wait(0.5)
    capturarOffsets(character)

    -- Reset contínuo dos braços (anti-recuo)
    if conexaoMotor then conexaoMotor:Disconnect() end
    conexaoMotor = RunService.RenderStepped:Connect(function()
        if not soundGunAtivado then return end
        if not estaComGun(character) then return end
        resetarMotores(character)
    end)

    -- 🔥 BLOQUEIO POR SNAPSHOT (pega QUALQUER animação nova)
    local c1 = animator.AnimationPlayed:Connect(function(track)
        if not estaComGun(character) then return end
        if animacaoPermitida(track) then return end

        -- Bloqueia com força total
        pcall(function() track:Stop(0) end)
        pcall(function() track:AdjustSpeed(0) end)
        pcall(function() track:AdjustWeight(0, 0) end)
        pcall(function() track.TimePosition = 0 end)
    end)
    table.insert(gunConnections, c1)

    -- 🔥 Quando equipa gun, captura animações permitidas
    local c2 = character.ChildAdded:Connect(function(c)
        if c:IsA("Tool") and isGun(c) then
            if actionSound then actionSound:Play() end
            -- Espera as animações de hold/idle carregarem, depois captura
            task.wait(0.3)
            capturarAnimacoesPermitidas(animator)
        end
    end)
    table.insert(gunConnections, c2)

    -- Som ao desequipar
    local c3 = character.ChildRemoved:Connect(function(c)
        if c:IsA("Tool") and isGun(c) then
            if actionSound then actionSound:Play() end
            table.clear(animacoesPermitidas)
        end
    end)
    table.insert(gunConnections, c3)

    -- Se já tiver gun equipada no momento do toggle, captura logo
    if estaComGun(character) then
        task.wait(0.3)
        capturarAnimacoesPermitidas(animator)
    end
end

-- ==========================================
-- UI + TOGGLE
-- ==========================================
local enabled = false

local function updateUI()
    if enabled then
        toggle.Text = "ON"
        toggle.BackgroundColor3 = Color3.fromRGB(0,255,0)
    else
        toggle.Text = "OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(255,0,0)
    end
end

local function toggleSoundGun()
    enabled = not enabled
    soundGunAtivado = enabled

    if soundGunAtivado then
        actionSound = Instance.new("Sound", SoundService)
        actionSound.SoundId = SOUND_ID
        actionSound.Volume = 1

        if player.Character then setupGunSystem(player.Character) end
        gunCharConnection = player.CharacterAdded:Connect(setupGunSystem)
    else
        if gunCharConnection then gunCharConnection:Disconnect() gunCharConnection = nil end
        if conexaoMotor then conexaoMotor:Disconnect() conexaoMotor = nil end
        for _, c in ipairs(gunConnections) do c:Disconnect() end
        table.clear(gunConnections)
        table.clear(animacoesPermitidas)
        if actionSound then actionSound:Destroy() actionSound = nil end
    end

    updateUI()
end

toggle.MouseButton1Click:Connect(toggleSoundGun)

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.E then
        toggleSoundGun()
    end
end)

updateUI()

-- ==========================================
-- DRAG
-- ==========================================
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
    local delta = input.Position - dragStart
    main.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end

main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

main.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)
