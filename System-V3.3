-- ==========================================
-- SOUND GUN - BLOQUEIO APENAS DE RELOAD E TIRO
-- ==========================================
local soundGunAtivado = false
local gunConnections = {}
local actionSound = nil
local gunCharConnection = nil
local SOUND_ID = "rbxassetid://6968135315"
local COOLDOWN_DURATION = 3

local ARMAS_ALVO = {
	"Gun", "Knife", "Revolver", "Pistol", "M9",
	"Colt", "Sheriff", "Luger", "Musket",
	"Gingerscope", "Scope", "Rifle", "Sniper", "Bow"
}

local ANIMACOES_BLOQUEAR = {
	"reload", "recarreg",
	"shoot", "fire", "atirar", "tiro",
	"recoil", "recuo",
	"kickback", "rechamber", "bolt", "cock"
}

local function isArmaAlvo(tool)
	if not tool then return false end
	local nome = tool.Name:lower()
	for _, alvo in ipairs(ARMAS_ALVO) do
		if nome:find(alvo:lower()) then
			return true
		end
	end
	return false
end

local function deveBloquear(track)
	local nome = ""
	pcall(function()
		if track.Animation then
			nome = track.Animation.Name:lower()
		end
	end)
	
	if nome == "" then return false end
	
	for _, palavra in ipairs(ANIMACOES_BLOQUEAR) do
		if nome:find(palavra) then
			return true
		end
	end
	
	return false
end

local function setupGunSystem(character)
	if not soundGunAtivado then return end
	
	local humanoid = character:WaitForChild("Humanoid", 10)
	local animator = humanoid and humanoid:WaitForChild("Animator", 10)
	local lastUnequippedTime = 0
	
	if animator then
		local c1 = animator.AnimationPlayed:Connect(function(track)
			local tool = character:FindFirstChildOfClass("Tool")
			local isHoldingArma = isArmaAlvo(tool)
			local timeSinceUnequip = os.clock() - lastUnequippedTime
			
			if (isHoldingArma or timeSinceUnequip <= COOLDOWN_DURATION) then
				if deveBloquear(track) then
					pcall(function() track:Stop(0) end)
					pcall(function() track:AdjustSpeed(0) end)
					pcall(function() track:AdjustWeight(0, 0) end)
				end
			end
		end)
		table.insert(gunConnections, c1)
	end
	
	local c2 = character.ChildAdded:Connect(function(c) 
		if isArmaAlvo(c) and c:IsA("Tool") and actionSound then 
			actionSound:Play() 
		end 
	end)
	
	local c3 = character.ChildRemoved:Connect(function(c) 
		if isArmaAlvo(c) and c:IsA("Tool") and actionSound then 
			actionSound:Play()
			lastUnequippedTime = os.clock() 
		end 
	end)
	
	table.insert(gunConnections, c2)
	table.insert(gunConnections, c3)
end

-- ==========================================
-- ESTADO VISUAL
-- ==========================================
local enabled = false

local function updateUI()
	if enabled then
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(0,255,0)
	else
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(255,0,0)
	end
end

-- 🔥 FUNÇÃO UNIFICADA DE TOGGLE (usada pelo botão E pela tecla E)
local function toggleSoundGun()
	enabled = not enabled
	soundGunAtivado = enabled
	
	if soundGunAtivado then
		actionSound = Instance.new("Sound", SoundService)
		actionSound.SoundId = SOUND_ID
		actionSound.Volume = 1
		
		if player.Character then 
			setupGunSystem(player.Character) 
		end
		gunCharConnection = player.CharacterAdded:Connect(setupGunSystem)
	else
		if gunCharConnection then 
			gunCharConnection:Disconnect() 
			gunCharConnection = nil
		end
		for _, c in ipairs(gunConnections) do 
			c:Disconnect() 
		end
		table.clear(gunConnections)
		if actionSound then 
			actionSound:Destroy() 
			actionSound = nil 
		end
	end
	
	updateUI()
end

-- Botão ON/OFF chama a função
toggle.MouseButton1Click:Connect(toggleSoundGun)

-- 🔥 TECLA E liga/desliga (igual ao botão)
UIS.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.E then
		toggleSoundGun()
	end
end)

updateUI()

-- DRAG
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
	local delta = input.Position - dragStart
	main.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

main.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)
