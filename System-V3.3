-- BLOQUEIO POR ANIMAÇÃO
-- ==========================================
local ANIMACOES_BLOQUEAR = {
    "recoil", "recuo", "kickback", "kick",
    "impact", "impacto", "punch", "push",
    "shoot", "fire", "atirar", "tiro", "shot",
    "gunshot", "fireshot", "shooting",
    "muzzle", "muzzleflash",
    "reload", "recarreg", "rechamber",
    "chamber", "bolt", "cock", "magazine", "mag",
    "load", "unload"
}

local ANIMACOES_PERMITIR = {
    "idle", "walk", "run", "jump", "fall",
    "climb", "swim", "sit", "hold", "equip",
    "tool", "pose", "death", "die",
    "aim", "aiming", "ready"
}

local function deveBloquear(track)
    local nome = ""
    pcall(function()
        if track.Animation then
            nome = track.Animation.Name:lower()
        end
    end)
    if nome == "" then return false end
    for _, p in ipairs(ANIMACOES_PERMITIR) do
        if nome:find(p) then return false end
    end
    for _, p in ipairs(ANIMACOES_BLOQUEAR) do
        if nome:find(p) then return true end
    end
    return false
end

-- ==========================================
-- SISTEMA
-- ==========================================
local soundGunAtivado = false
local gunConnections = {}
local actionSound = nil
local gunCharConnection = nil
local SOUND_ID = "rbxassetid://6968135315"

local ultimaGunTempo = 0
local COOLDOWN_MEMORIA = 5

-- 🔥 CONTROLE MOTOR6D DIRETO (resolve o impacto pra trás)
local conexaoMotor = nil
local offsetsOriginais = {}  -- guarda C0 original dos ombros

local function resetarMotores(character)
    -- Reseta os C0 dos ombros pro original (tira o "recuo" visual)
    for _, nome in ipairs({"Right Shoulder", "Left Shoulder"}) do
        local ombro = character:FindFirstChild("Torso") and character.Torso:FindFirstChild(nome)
        if not ombro then
            ombro = character:FindFirstChild(nome)
        end
        if ombro and offsetsOriginais[nome] then
            ombro.C0 = offsetsOriginais[nome]
        end
    end
end

local function setupGunSystem(character)
    if not soundGunAtivado then return end
    
    local humanoid = character:WaitForChild("Humanoid", 10)
    local animator = humanoid and humanoid:WaitForChild("Animator", 10)
    
    -- 🔥 Guarda os offsets originais dos ombros
    task.wait(0.5)
    for _, nome in ipairs({"Right Shoulder", "Left Shoulder"}) do
        local ombro = character:FindFirstChild(nome)
        if not ombro and character:FindFirstChild("Torso") then
            ombro = character.Torso:FindFirstChild(nome)
        end
        if ombro and ombro:IsA("Motor6D") then
            offsetsOriginais[nome] = ombro.C0
        end
    end
    
    -- 🔥 RenderStepped: se o braço se mover durante tiro, volta
    if conexaoMotor then conexaoMotor:Disconnect() end
    conexaoMotor = RunService.RenderStepped:Connect(function()
        if not soundGunAtivado then return end
        local tempoDesdeGun = os.clock() - ultimaGunTempo
        if tempoDesdeGun > COOLDOWN_MEMORIA then return end
        
        -- Se o mouse está travado (atirando/ADS), mantém braço fixo
        if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then
            resetarMotores(character)
        end
    end)
    
    if animator then
        local c1 = animator.AnimationPlayed:Connect(function(track)
            local tempoDesdeGun = os.clock() - ultimaGunTempo
            if tempoDesdeGun <= COOLDOWN_MEMORIA and deveBloquear(track) then
                pcall(function() track:Stop(0) end)
                pcall(function() track:AdjustSpeed(0) end)
                pcall(function() track:AdjustWeight(0, 0) end)
                pcall(function() track.TimePosition = 0 end)
            end
        end)
        table.insert(gunConnections, c1)
    end
    
    local c2 = character.ChildAdded:Connect(function(c) 
        if c:IsA("Tool") and isGun(c) then
            ultimaGunTempo = os.clock()
            if actionSound then actionSound:Play() end
        end 
    end)
    
    local c3 = character.ChildRemoved:Connect(function(c) 
        if c:IsA("Tool") and isGun(c) then
            ultimaGunTempo = os.clock()
            if actionSound then actionSound:Play() end
        end 
    end)
    
    table.insert(gunConnections, c2)
    table.insert(gunConnections, c3)
end

local enabled = false

local function updateUI()
    if enabled then
        toggle.Text = "ON"
        toggle.BackgroundColor3 = Color3.fromRGB(0,255,0)
    else
        toggle.Text = "OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(255,0,0)
    end
end

local function toggleSoundGun()
    enabled = not enabled
    soundGunAtivado = enabled
    
    if soundGunAtivado then
        actionSound = Instance.new("Sound", SoundService)
        actionSound.SoundId = SOUND_ID
        actionSound.Volume = 1
        
        if player.Character then setupGunSystem(player.Character) end
        gunCharConnection = player.CharacterAdded:Connect(setupGunSystem)
    else
        if gunCharConnection then gunCharConnection:Disconnect() gunCharConnection = nil end
        if conexaoMotor then conexaoMotor:Disconnect() conexaoMotor = nil end
        for _, c in ipairs(gunConnections) do c:Disconnect() end
        table.clear(gunConnections)
        if actionSound then actionSound:Destroy() actionSound = nil end
    end
    
    updateUI()
end

toggle.MouseButton1Click:Connect(toggleSoundGun)

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.E then
        toggleSoundGun()
    end
end)

updateUI()

-- DRAG
local dragging = false
local dragInput
local dragStart
local startPos

local function update(input)
    local delta = input.Position - dragStart
    main.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end

main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

main.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)
